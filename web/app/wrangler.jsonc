  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "easycrm-media" }],
  "vars": {
    "SUPABASE_URL": "https://wgfpbkwjrejnlliznfdu.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_fzbWR-ofh2QQPdv8-o_W_w__rrMIP3d"
  },
  "routes": [{ "pattern": "crm.kerryhatcher.com", "custom_domain": true }]
}
