{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "easycrm-web",
  "account_id": "6d837580a4d0641139ecada9e74076b8",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
